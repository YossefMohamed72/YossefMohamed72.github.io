RewriteRule ^products\.html$ /en/products [R=301,L]
RewriteRule ^squash\.html$ /en/squash [R=301,L]
RewriteRule ^artichokes\.html$ /en/artichokes [R=301,L]
RewriteRule ^quality\.html$ /en/quality [R=301,L]
RewriteRule ^export\.html$ /en/export [R=301,L]
RewriteRule ^gallery\.html$ /en/gallery [R=301,L]
